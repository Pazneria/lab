      "ids": [
        "design2code-v3-484"
      ],
      "source_urls": [
        "https://salt-nlp.github.io/Design2Code/",
        "https://github.com/NoviScl/Design2Code"
      ],
      "decision": "preserve_historical",
      "finding": "484 screenshot-to-code webpage cases from C4; HARD has a separate 80-case set. Visual, element, text, position and color measurements and prompt variants must stay separate. No verified new frontier model result found."
    },
    {
      "ids": [
        "frontendbench-2025-paper",
        "webgen-bench-2025",
        "cattest-2026"
      ],
      "source_urls": [
        "https://arxiv.org/abs/2506.13832",
        "https://arxiv.org/abs/2505.03733",
        "https://github.com/harbor-framework/harbor/blob/main/adapters/webgen_bench/README.md",
        "https://arxiv.org/abs/2609.00081"
      ],
      "decision": "source_only",
      "finding": "FrontendBench has 148 prompt/test pairs; WebGen-Bench tests generated website behavior with 647 interaction tests and requires harness-specific timeout disclosure. CATTest covers bug discovery in 102 generated apps, not generation quality. No comparable current frontier functional completion table verified."
    },
    {
      "ids": [
        "bench2drive"
      ],
      "source_urls": [
